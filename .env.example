# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Auth (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Razorpay (leave empty to use demo payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend email (leave empty to log emails to the server console)
RESEND_API_KEY=
EMAIL_FROM="Elite Weavers <orders@eliteweavers.example>"

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional seed administrator password (set before the first seed in production)
SEED_ADMIN_PASSWORD=
